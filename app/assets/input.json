{
  "$schema": "../../engine/schemas/input.schema",
  "actions": {
    "reset": {
      "keys": ["P"],
      "buttons": [8]
    },
    "respawn": {
      "keys": ["R"],
      "buttons": [0]
    },
    "nextCamera": {
      "keys": ["C"],
      "buttons": [6]
    },
    "toggleFlightAssist": {
      "keys": ["TAB"],
      "buttons": [2]
    }
  },
  "axes": {
    "yaw": {
      "keys": [
        { "negative": "E", "positive": "Q" }
      ]
    },
    "pitch": {
      "keys": [
        { "negative": "DOWN", "positive": "UP" }
      ],
      "gamepad": [
        { "axis": 1, "invert": true }
      ]
    },
    "roll": {
      "keys": [
        { "negative": "LEFT", "positive": "RIGHT" }
      ],
      "gamepad": [
        { "axis": 0 }
      ]
    },
    "thrustX": {
      "keys": [
        { "negative": "S", "positive": "W" }
      ],
      "gamepad": [
        { "axis": 4, "invert": true },
        { "axis": 5, "invert": false }
      ]
    },
    "thrustY": {
      "keys": [
        { "negative": "D", "positive": "A" }
      ],
      "gamepad": [
        { "axis": 1 }
      ]
    },
    "thrustZ": {
      "keys": [
        { "negative": "LEFT_SHIFT", "positive": "SPACE" }
      ],
      "gamepad": [
        { "axis": 2 }
      ]
    },
    "cameraYaw": {
      "keys": [
        { "negative": "L", "positive": "J" }
      ],
      "gamepad": [
        { "axis": 2, "invert": true }
      ]
    },
    "cameraPitch": {
      "keys": [
        { "negative": "I", "positive": "K" }
      ],
      "gamepad": [
        { "axis": 3, "invert": false }
      ]
    },
    "cameraZoom": {
      "keys": [
        { "negative": "U", "positive": "O" }
      ]
    }
  }
}