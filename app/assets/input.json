{
  "$schema": "../../engine/schemas/input.schema",
  "actions": {
    "reset": {
      "keys": ["SPACE"],
      "buttons": [0]
    },
    "rotationStart": {
      "mouseButtons": [0]
    },
    "nextCamera": {
      "keys": ["C"],
      "buttons": [6]
    }
  },
  "axes": {
    "yaw": {
      "keys": [
        { "negative": "E", "positive": "Q" }
      ],
      "gamepad": [
        { "axis": 2, "invert": true }
      ]
    },
    "pitch": {
      "keys": [
        { "negative": "S", "positive": "W" },
        { "negative": "DOWN", "positive": "UP" }
      ],
      "gamepad": [
        { "axis": 1, "invert": true }
      ]
    },
    "roll": {
      "keys": [
        { "negative": "A", "positive": "D" },
        { "negative": "LEFT", "positive": "RIGHT" }
      ],
      "gamepad": [
        { "axis": 0 }
      ]
    }
  }
}
